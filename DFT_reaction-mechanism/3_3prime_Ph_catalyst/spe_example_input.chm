source /path_to/turbomole.tcl

read_xyz file=ts_opt.xyz coords=c

set tmole_args \
    [ list \
         basis=def2-TZVP \
         hamiltonian=wB97X \
         ri_memory=1000 \
         accuracy=veryhigh \
         charge=0 \
         mult=1 \
         maxcyc=1000 \
         cosmo=yes\
         epsilon=7.53\
         ]

energy coords=c \
   theory=turbomole: $tmole_args list_option=full \
   energy=e_wB97X

times
return ok


